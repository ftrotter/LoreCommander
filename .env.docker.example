# Docker Environment Variables for LoreCommander
# Copy this file to .env in the LoreCommander directory and update with your values

APP_NAME=LoreCommander
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack

# Database Configuration (used by both app and db services)
# DB_HOST must be 'db' to match the Docker service name
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lorecommander
DB_USERNAME=loreuser
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Cache/Session Configuration
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# GitHub Token (optional - only needed for private packages)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=
