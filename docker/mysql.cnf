# MySQL/MariaDB configuration for LoreCommander
# This file is mounted into the container to set server defaults

[mysqld]
# Character set and collation defaults
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Ensure all connections use utf8mb4
init-connect = 'SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci'

# Skip character set client handshake - forces server charset on all connections
skip-character-set-client-handshake

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
