{
    "name": "ftrotter/lore",
    "description": "Lore Commander MTG Data Analysis Project",
    "keywords": [
        "MTG",
        "zermelo"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../Zermelo",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../DURC",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "proai/laravel-handlebars": "^1.6",
        "laravel/framework": "^8.0",
        "phpunit/phpunit": "^9.5",
        "pusher/pusher-php-server": "^4.0",
        "sunra/php-simple-html-dom-parser": "^1.5",
        "superbalist/flysystem-google-storage": "^7.0",
        "vlucas/phpdotenv": "^5.2",
        "ftrotter/zzermelo": "dev-main",
        "ftrotter/durcc": "dev-main"
    },
    "require-dev": {
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "CareSet\\DURC\\": "../DURC/src/",
            "CareSet\\Zermelo\\": "../Zermelo/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "preferred-install": "source",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true
        }
    }
}
